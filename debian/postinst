#!/bin/sh
set -e

case "$1" in
configure)
    if [ ! -d /etc/kira/keys ]; then
        # Deliberately not automatic: seal generates a NEW TOTP secret and
        # prints a QR code that has to be scanned interactively.
        echo "kira: not configured yet. Run 'sudo kira setup' to create"
        echo "kira: signing keys, 'sudo kira slot add' to seal a TOTP secret,"
        echo "kira: then rebuild the initramfs with 'sudo update-initramfs -u'."
    fi

    if command -v update-initramfs >/dev/null 2>&1; then
        update-initramfs -u
    fi
    ;;
esac

#DEBHELPER#

exit 0
