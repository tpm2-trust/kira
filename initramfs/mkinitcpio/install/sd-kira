#!/bin/bash

# Units that measure into PCRs before kira runs. Their presence changes the
# values kira must seal against, so the verdict is reported and handed to
# the post hook rather than being guessed at approve time.
MEASURE_POINT_STATE=/run/kira/measure-point.state

_unit_wired() {
    local name=$1
    compgen -G "$BUILDROOT/usr/lib/systemd/system/*.wants/$name" > /dev/null ||
        compgen -G "$BUILDROOT/etc/systemd/system/*.wants/$name" > /dev/null
}

_report_measure_point() {
    local -a active=()
    local unit

    for unit in systemd-pcrosseparator.service systemd-pcrphase-initrd.service; do
        if [[ -e $BUILDROOT/usr/lib/systemd/system/$unit ]]; then
            if _unit_wired "$unit"; then
                active+=("$unit")
            else
                warning "kira: $unit is present but not enabled in this initramfs"
            fi
        fi
    done

    mkdir -p "$(dirname "$MEASURE_POINT_STATE")"
    if (( ${#active[@]} > 0 )); then
        printf 'on\n' > "$MEASURE_POINT_STATE"
        plain "kira: measure-point units active: ${active[*]}"
        plain "kira:   the display runs after enter-initrd (PCR 11) and before the os-separator,"
        plain "kira:   which then locks the TOTP secret until the next boot"
    else
        printf 'off\n' > "$MEASURE_POINT_STATE"
        plain "kira: no systemd measure-point units in this initramfs; sealing against end-of-firmware values"
    fi
}

CONF=${KIRA_CONTROL_CONF:-/etc/kira/control.conf}

# The binaries: the package's in /usr/bin, or make install's in
# /usr/local/bin, which mkinitcpio's PATH (/usr/bin:/bin) leaves out.
# kira decides the plan here; the image carries kira-boot alone,
# as /usr/bin/kira-boot, where the units find it.
KIRA=$(PATH=$PATH:/usr/local/bin type -P kira)
KIRA_BOOT=$(PATH=$PATH:/usr/local/bin type -P kira-boot)

# A unit of kira's. add_systemd_unit adds the binary of each Exec line
# as this machine's PATH finds it, which make install's is not on; build
# has put it into the image already. The rest goes as add_systemd_unit
# has it.
_add_kira_unit() {
    local orig
    orig=$(declare -f add_binary)
    if [[ -z $orig ]]; then
        add_systemd_unit "$1"
        return
    fi
    eval "_kira_$orig"
    add_binary() { [[ $1 == kira-boot ]] || _kira_add_binary "$@"; }
    add_systemd_unit "$1"
    eval "$orig"
    unset -f _kira_add_binary
}
PLAN=/etc/kira/plan

# The boot plan (internal/admin/bootplan.go): what this image carries besides the disk
# unlock, decided by 'kira initramfs plan' from what the machine uses -
# the slots in the TPM and what they are enrolled with, the signing key,
# the Bluetooth adapter, the network and SSH settings of control.conf.
# Each part is in only when something uses it, and the build output says
# why one is out. The plan writes the image's own files (the signing public
# key, the network file, the sealed SSH host key, the drop-ins) and names
# its parts in $PLAN; this hook adds the units and the drivers it lists.
# control.conf never goes into the image, and this hook does not read it.
# Nothing here stops the build: a part that cannot be had stays out.
_plan_has() {
    [[ -d $BUILDROOT$PLAN/$1 ]]
}

_add_plan() {
    # efivarfs, whatever the plan: run reads Secure Boot's state at every boot, and
    # the slots' records are there. Mounted by systemd itself; added for a kernel that
    # has it as a module (built in, nothing to add).
    add_module efivarfs
    local out kind value nfw=0 adapter
    local -a btmods=() btfw=() netmods=()
    if ! out=$("$KIRA" initramfs plan --format mkinitcpio --conf "$CONF" --buildroot "$BUILDROOT"); then
        warning "kira: the installed kira made no boot plan: the image unlocks the disk and carries nothing else"
        return 0
    fi
    while read -r kind value; do
        case $kind in
            say) plain "kira: $value" ;;
            warning) warning "kira: $value" ;;
            bt-module) btmods+=("$value") ;;
            bt-firmware) btfw+=("$value") ;;
            net-module) add_module "$value" && netmods+=("$value") ;;
            net-modules-all) add_checked_modules /drivers/net ;;
            module) add_module "$value" ;;
        esac
    done <<< "$out"

    # The close (PCR 15) when the code screen is over, whether the image
    # serves SSH or not: every slot object's policy and the SSH CA's read
    # PCR 15, so nothing in the running system can compute a code, open a
    # slot's part or have a key certified until the next boot - whenever a
    # slot is sealed or an SSH CA exists (the plan's TPM part), whatever
    # their methods. Required by initrd.target: a close that fails reboots.
    # The late closer goes with it: it starts when the close went on without
    # an answer from the TPM.
    if _plan_has tpm; then
        _add_kira_unit kira-close.service
        add_symlink /usr/lib/systemd/system/initrd.target.requires/kira-close.service \
            /usr/lib/systemd/system/kira-close.service
        _add_kira_unit kira-late-close.service
        add_symlink /usr/lib/systemd/system/initrd.target.wants/kira-late-close.service \
            /usr/lib/systemd/system/kira-late-close.service
    fi

    # The phone's gate (PLAN-BLE.md §3.1): the adapter's driver modules and
    # the firmware the kernel loaded for it on this machine. add_module
    # copies every firmware file a module declares: for btusb's dependencies
    # that is ~60 files for chips this machine does not have. When the
    # kernel log named the files this adapter really loaded, only those go
    # in; otherwise the declarations.
    if _plan_has phone; then
        local saved_add_firmware=''
        if (( ${#btfw[@]} )); then
            saved_add_firmware=$(declare -f add_firmware)
            add_firmware() { return 0; }
        fi
        for value in "${btmods[@]}"; do
            add_module "$value"
        done
        if [[ -n $saved_add_firmware ]]; then
            eval "$saved_add_firmware"
        fi
        for value in "${btfw[@]}"; do
            add_firmware "$value" && nfw=$((nfw + 1))
        done
        plain "kira: Bluetooth: ${#btmods[@]} modules, $nfw firmware files"
    fi

    # The network: systemd-networkd with its user, from the plan's file
    # alone - /etc/systemd/network is the running system's. The SSH server
    # is kira itself ('run' and its unprivileged 'ssh-child'): its
    # drop-in is the plan's, nothing more to add.
    if _plan_has net; then
        add_systemd_unit systemd-networkd.service
        add_symlink /usr/lib/systemd/system/sysinit.target.wants/systemd-networkd.service \
            /usr/lib/systemd/system/systemd-networkd.service
        # The installed system's machine-id, released before networkd starts:
        # it asks DHCP as the installed system does (v4 and v6).
        _add_kira_unit kira-machine-id.service
        add_symlink /usr/lib/systemd/system/sysinit.target.wants/kira-machine-id.service \
            /usr/lib/systemd/system/kira-machine-id.service
        local db
        for db in passwd shadow group; do
            grep '^systemd-network:' "/etc/$db" >> "$BUILDROOT/etc/$db"
        done
        (( ${#netmods[@]} )) && plain "kira: network drivers: ${netmods[*]}"
    fi
    return 0
}

UNLOCK_SOCKET=/run/kira/unlock.sock

# The disk's unlock goes through kira when the volume's key file is
# kira's socket: systemd-cryptsetup reads the key from there
# (crypttab(5), "AF_UNIX KEY FILES") and kira answers once the code
# screen is confirmed. The key file is named on the kernel command line,
# rd.luks.key=<UUID>=/run/kira/unlock.sock, honoured in the initrd
# only (systemd-cryptsetup-generator(8)); or, for a volume kept in
# /etc/crypttab with x-initrd.attach, in that line's key field. This hook
# adds the socket unit and reports what it finds configured: the command
# line of the running system and the files the UKI is built from, and the
# crypttab. Nothing is written.
_add_unlock() {
    local crypttab=${1:-/etc/crypttab}
    shift
    local -a cmdlines=("$@")
    (( ${#cmdlines[@]} )) || cmdlines=(/proc/cmdline /etc/kernel/cmdline /etc/cmdline.d/*.conf)
    local f word uuid name key opts routed=0

    # systemd-cryptsetup's units are ordered after cryptsetup-pre.target, the socket and
    # the close before it; without the file in the image none of that orders anything,
    # and sd-encrypt brings only cryptsetup.target.
    add_systemd_unit cryptsetup-pre.target
    _add_kira_unit kira-unlock.socket
    add_symlink /usr/lib/systemd/system/sysinit.target.wants/kira-unlock.socket \
        /usr/lib/systemd/system/kira-unlock.socket
    # How the disk's key is made is not configured: the key provider reads
    # each volume's LUKS2 header at boot (the kira tokens).

    # Is any volume routed through the socket at all (the command line, or
    # an x-initrd.attach line of crypttab)? Said only when none is.
    for f in "${cmdlines[@]}"; do
        [[ -r $f ]] || continue
        for word in $(< "$f"); do
            case $word in
                rd.luks.key=*=$UNLOCK_SOCKET|luks.key=*=$UNLOCK_SOCKET|rd.luks.key=$UNLOCK_SOCKET|luks.key=$UNLOCK_SOCKET)
                    routed=1
                    ;;
            esac
        done
    done
    while read -r name _ key opts; do
        [[ $key == "$UNLOCK_SOCKET" ]] && routed=1
    done < <(awk '!/^\s*($|#)/ && $4 ~ /x-initrd\.attach/' "$crypttab" 2>/dev/null)

    # The devices with a keyslot of kira's, one line each: where the
    # key comes from, or what is wrong and what the line should read
    # ('kira luks route'; it edits nothing).
    local -a routeargs=()
    for f in "${cmdlines[@]}"; do
        [[ $f == /proc/cmdline ]] && continue
        routeargs+=(--cmdline "$f")
    done
    local advice line
    if advice=$("$KIRA" luks route "${routeargs[@]}" --crypttab "$crypttab" 2>&1); then
        while IFS= read -r line; do [[ -n $line ]] && plain "kira: $line"; done <<< "$advice"
    else
        warning "kira: the disk's key is not routed through kira everywhere - the files below are not edited; change them as shown and rebuild:"
        while IFS= read -r line; do plain "    $line"; done <<< "$advice"
    fi
    if (( ! routed )); then
        warning "kira: no volume is unlocked through kira yet; add rd.luks.key=<UUID>=$UNLOCK_SOCKET next to rd.luks.name= on the kernel command line (README, \"Configure the disk unlock\")"
    fi
}

build() {
    if [[ -z $KIRA || -z $KIRA_BOOT ]]; then
        error "kira: kira and kira-boot are not both installed (/usr/bin or /usr/local/bin)"
        return 1
    fi
    add_binary "$KIRA_BOOT" /usr/bin/kira-boot

    # The display and the key provider, enabled in the image only:
    # add_systemd_unit only carries over .wants symlinks that already exist
    # on the host, and the host's own boot stays untouched. It waits for
    # the TPM only when a part of the plan needs it (the plan's drop-in).
    _add_kira_unit kira.service
    add_symlink /usr/lib/systemd/system/sysinit.target.wants/kira.service \
        /usr/lib/systemd/system/kira.service

    _report_measure_point

    _add_unlock

    _add_plan
}

help() {
    cat <<HELPEOF
This hook puts kira into a systemd-based initramfs: the disk unlock
always, and what the machine uses besides, by the boot plan
('kira initramfs plan', 'kira help initramfs').

The hook will:
- Install the kira binary into the image, with kira.service and
  kira-unlock.socket, enabled inside the image only
- Report which volumes are unlocked through kira: those whose key
  file is /run/kira/unlock.sock (crypttab(5), AF_UNIX key files),
  named on the kernel command line as rd.luks.key=<UUID>=/run/kira/unlock.sock
  or in the key field of an x-initrd.attach line of /etc/crypttab.
  systemd-cryptsetup reads the key from kira, which makes it as the
  volume's LUKS2 header says. Nothing is written.
- Add each part of the boot plan that something uses, and say why the
  others are out:
    TOTP codes   a slot is sealed: run waits for the TPM (5 s); with the TPM
                 in the plan (a sealed slot, an SSH CA), run and then
                 kira-close.service close the boot (PCR 15: every slot
                 and the SSH CA) when the code screen is over
    Phone        a phone is enrolled (or KIRA_ATTEST_BLUETOOTH=always):
                 the adapter's driver and firmware, the signing public key;
                 run starts the radio worker (gate-child) itself
    Vault        a slot is enrolled with a vault, the image has a network, and
                 /etc/kira/vault-ca.pem holds the vaults' roots (copied in)
    TPM salt     a slot holds a TPM salt (recipe 0x1200): run opens it while
                 the code screen holds
    Network      KIRA_NET in /etc/kira/control.conf: systemd-networkd
                 and the matched interface's driver
    SSH server   KIRA_SSH=on: kira's own, run unprivileged; the
                 host key made in the TPM at boot, certified by the SSH CA
                 of the EFI variable KIRAasshCA (efivarfs)
  A machine without a TPM gets the disk unlock alone.

Post-generation hook (sd-kira in /usr/lib/initcpio/post/, or
/etc/initcpio/post/ from make install-mkinitcpio):
  After the initramfs image is written, 'kira slot approve' is executed
  automatically. This is necessary because the initramfs content is
  measured into PCRs at boot - every rebuild may change the expected
  values, so the sealed TOTP secret must be approved to match, and the
  SSH CA approved for them.

Prerequisites:
- systemd-based initramfs (mkinitcpio with systemd support, sd-encrypt)
- kira binary installed, in /usr/bin or /usr/local/bin

Usage in /etc/mkinitcpio.conf (either order):
  HOOKS=(... sd-kira sd-encrypt ...)
and on the kernel command line, next to rd.luks.name=<UUID>=cryptroot:
  rd.luks.key=<UUID>=/run/kira/unlock.sock
HELPEOF
}
