#!/bin/sh
# initramfs-tools hook: place kira into the initramfs image - the disk
# unlock always, and what the machine uses besides, by the boot plan.
#
# No key material is copied. 'run' reads the sealed blob from TPM NVRAM and
# has the TPM compute the codes under the slot's policy, so the signing keys stay on the
# encrypted root where they belong.

set -e

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /usr/share/initramfs-tools/hook-functions

# The binaries: the package's in /usr/bin, or make install's in
# /usr/local/bin, which mkinitramfs' PATH (/usr/bin:/sbin:/bin) leaves out.
# kira decides the plan here; the image carries kira-boot alone,
# as /usr/bin/kira-boot, where the scripts run it.
kira=$(PATH="$PATH:/usr/local/bin" command -v kira || true)
kira_boot=$(PATH="$PATH:/usr/local/bin" command -v kira-boot || true)
if [ -z "$kira" ] || [ -z "$kira_boot" ]; then
    echo "kira: kira and kira-boot are not both installed (/usr/bin or /usr/local/bin); refusing to build an initramfs" >&2
    echo "kira: that silently shows no TOTP code at boot" >&2
    exit 1
fi

copy_exec "$kira_boot" /usr/bin/kira-boot

# The devices with a keyslot of kira's: does /etc/crypttab route each
# through the keyscript, and if not, what the line should read
# ('kira luks route'; it edits nothing).
if advice=$("$kira" luks route 2>&1); then
    [ -n "$advice" ] && echo "kira: $advice"
else
    echo "kira: the disk's key is not routed through kira everywhere - /etc/crypttab is not edited; change it as shown and run update-initramfs -u:" >&2
    echo "$advice" | sed 's/^/    /' >&2
fi

# The boot plan (internal/admin/bootplan.go): what this image carries besides the disk
# unlock, decided by 'kira initramfs plan' from what the machine uses -
# the slots in the TPM and what they are enrolled with, the signing key,
# the Bluetooth adapter, the network and SSH settings of
# /etc/kira/control.conf. Each part is in only when something uses it,
# and the output says why one is out. The plan writes the image's own
# files (the signing public key, the adapter's module list and udev rule,
# remote.conf, assh.conf and the keys that may log in, udhcpc's script) and
# names its parts in
# /etc/kira/plan, which the boot scripts read; this hook adds the
# drivers and firmware it lists. control.conf never goes into the image.
# The network needs busybox (ip, and udhcpc for DHCP with the running
# system's client identifier).
nobusybox=
if [ "${BUSYBOX:-auto}" = n ] || ! command -v busybox >/dev/null 2>&1; then
    nobusybox=--no-busybox
fi
if ! plan=$("$kira" initramfs plan --format initramfs-tools --buildroot "$DESTDIR" $nobusybox); then
    echo "kira: the installed kira made no boot plan: the image unlocks the disk and carries nothing else" >&2
    exit 0
fi
nbt=0
nfw=0
nnet=""
# A here-document keeps the loop in this shell, so the counters survive it.
while read -r kind value; do
    case "$kind" in
    say) echo "kira: $value" ;;
    warning) echo "kira: WARNING: $value" >&2 ;;
    bt-module)
        # Loaded by the image's init before init-premount, as
        # systemd-modules-load does under mkinitcpio.
        force_load "$value"
        nbt=$((nbt + 1))
        ;;
    bt-firmware)
        add_firmware "$value"
        nfw=$((nfw + 1))
        ;;
    net-module)
        manual_add_modules "$value"
        nnet="$nnet $value"
        ;;
    net-modules-all) auto_add_modules net ;;
    module) manual_add_modules "$value" ;;
    esac
done <<PLAN
$plan
PLAN

# efivarfs, whatever the plan, loaded by the image's init: run reads Secure Boot's
# state at every boot, and the slots' records and the sealed machine-id are EFI
# variables. Debian's kernel has it as a module its initramfs neither loads nor
# mounts (the premount script mounts it).
force_load efivarfs
# The TPM's drivers: built in on most kernels, but modules on some machines.
if [ -d "$DESTDIR/etc/kira/plan/tpm" ]; then
    manual_add_modules tpm_tis
    manual_add_modules tpm_crb
fi
[ -d "$DESTDIR/etc/kira/plan/phone" ] && echo "kira: Bluetooth: $nbt modules, $nfw firmware files"
[ -n "$nnet" ] && echo "kira: network drivers:$nnet"
exit 0
