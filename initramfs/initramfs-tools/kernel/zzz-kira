#!/bin/sh
# Run by the kernel package hooks (/etc/kernel/postinst.d, postrm.d) after
# zz-update-grub has written the new grub.cfg: the last word on what GRUB
# will measure at the next boot. Records the kernel installed, or takes the
# records of the one removed; then reseals with PCR 8 and 9 predicted from
# this boot's event log and the files on disk (the new kernel, its initrd,
# the menu entries of the new grub.cfg).
#   $1 kernel version   $2 kernel image path

set -e

# The kernel's records (internal/measure/grub_vouch.go), on the encrypted
# root, which no one writing /boot offline reaches: installed, the SHA-256 of
# the image; removed, its image's and its initrd's records go with it. The
# prediction takes a kernel other than the booted one only with files they
# (or dpkg) vouch for. Kept whether kira is set up or not, so that none
# outlives its kernel; a version that could name another place is passed over.
records=/var/lib/kira/kernels
case "$1" in
''|.*|*/*) ;;
*)
    case "$0" in
    */postrm.d/*)
        rm -f "$records/vmlinuz-$1" "$records/initrd.img-$1" || echo "kira: the records of kernel $1 in $records are not removed" >&2
        ;;
    *)
        if [ -f "$2" ] && digest=$(sha256sum < "$2") && mkdir -p -m 700 "$records"; then
            printf '%s\n' "${digest%% *}" > "$records/vmlinuz-$1" || echo "kira: kernel $1 is not recorded in $records" >&2
        fi
        ;;
    esac
    ;;
esac

# make install puts kira in /usr/local/bin, which the PATH this runs
# with may leave out.
PATH=$PATH:/usr/local/bin

command -v kira >/dev/null 2>&1 || exit 0
[ -d /etc/kira/keys ] || exit 0
# Something to approve: a sealed slot, or the SSH CA (its EFI variable).
kira slot list 2>/dev/null | grep -q '^Slots:' || [ -e /sys/firmware/efi/efivars/KIRAasshCA-24415b90-39be-45c0-a9a3-d547ebe28ea0 ] || exit 0

echo "kira: kernel $1 and grub.cfg changed; approving for the next boot" >&2
# No terminal (setsid): a PIN it cannot read from /etc/kira/pin ends the
# approve with the reason (an ignored KIRA_PIN is in it) instead of a prompt
# that would hold the update.
# --unattended: a moved phone channel stays as it is, and it says so.
# A failure of kira is its status and its words; the update goes on with them. A
# refused memory lock (a container's root, a unit without CAP_IPC_LOCK under a limit) is such a failure.
rc=0
output=$(setsid -w kira slot approve --unattended </dev/null 2>&1) || rc=$?
printf '%s\n' "$output"
if [ "$rc" -ne 0 ] || printf '%s\n' "$output" | grep -q 'FAILED:'; then
    echo "kira: the approval did not succeed; the next boot shows no code until 'kira slot approve' does" >&2
fi
exit 0
