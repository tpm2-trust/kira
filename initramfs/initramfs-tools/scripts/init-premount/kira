#!/bin/sh
# Show the TOTP code before the root filesystem is unlocked.
#
# init-premount runs from /init; local-top/cryptroot runs later, from mountroot.
# That ordering is what puts this output ahead of the passphrase prompt.

set -e

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /scripts/functions

[ -x /usr/bin/kira-boot ] || exit 0

if command -v wait_for_udev >/dev/null 2>&1; then
    wait_for_udev 10
fi

# The parts the image carries (internal/admin/bootplan.go): written by the
# hook, one directory each. run starts what they name, and nothing else -
# the phone's radio worker and the SSH server's unprivileged half are its
# own children - and waits for the TPM itself when a part needs it, as
# under systemd. The adapter's modules are loaded by the image's init
# (the hook's force_load).
PLAN=/etc/kira/plan

# The key socket, where the keyscript of crypttab's
# keyscript=/lib/cryptsetup/scripts/kira takes the volume's key from
# (under systemd: the socket unit).
mkdir -p -m 700 /run/kira
UNLOCK=/run/kira/unlock.sock

# The network and the SSH server (docs/SSH.md), written by the plan from
# control.conf only when they are in it.
KIRA_NET=off
KIRA_REMOTE=
[ -r /etc/kira/remote.conf ] && . /etc/kira/remote.conf

# kira_netdev prints the interface the network is for: the one with
# the MAC or the name KIRA_NET_MATCH says, or the first wired one.
kira_netdev() {
    for d in /sys/class/net/*; do
        [ -e "$d/device" ] || continue
        case "${KIRA_NET_MATCH:-}" in
        *:*)
            [ "$(cat "$d/address" 2>/dev/null)" = "$KIRA_NET_MATCH" ] || continue
            ;;
        "")
            [ -e "$d/wireless" ] || [ -e "$d/phy80211" ] && continue
            ;;
        *)
            [ "${d##*/}" = "$KIRA_NET_MATCH" ] || continue
            ;;
        esac
        echo "${d##*/}"
        return 0
    done
    return 1
}

# kira_net brings the network up, in the background: the code screen
# does not wait for it. DHCP asks as the running system does: with its
# client identifier (KIRA_NET_CLIENTID) busybox' udhcpc, without one
# initramfs-tools' own (klibc's ipconfig, as for an NFS root or
# dropbear-initramfs), which sends none. A static address is busybox' ip.
# The interface is noted for init-bottom, which takes it down again.
kira_net() {
    # ipconfig fails each try it times out, and a static address may be
    # set already: neither ends the setup.
    set +e
    i=0
    while ! dev=$(kira_netdev); do
        if [ "$i" -ge 180 ]; then
            echo "kira: network: no interface ${KIRA_NET_MATCH:-wired} appeared"
            return 1
        fi
        sleep 1
        i=$((i + 1))
    done
    echo "$dev" > /run/kira/net-device
    case "$KIRA_NET" in
    dhcp)
        if [ -n "${KIRA_NET_CLIENTID:-}" ]; then
            ip link set dev "$dev" up
            until busybox udhcpc -f -q -n -t 5 -T 3 -i "$dev" -s /etc/kira/udhcpc.script \
                -x "0x3d:$KIRA_NET_CLIENTID"; do
                sleep 1
            done
        else
            unset BOOTIF
            DEVICE=$dev
            IP=dhcp
            configure_networking
        fi
        ;;
    static)
        ip link set dev "$dev" up
        for a in $KIRA_NET_ADDRESS; do
            ip address add "$a" dev "$dev"
        done
        for g in $KIRA_NET_GATEWAY; do
            case "$g" in
            *:*) ip -6 route add default via "$g" dev "$dev" ;;
            *) ip route add default via "$g" dev "$dev" ;;
            esac
        done
        : > /etc/resolv.conf
        for n in $KIRA_NET_DNS; do
            echo "nameserver $n" >> /etc/resolv.conf
        done
        ;;
    esac
    echo "kira: network: $KIRA_NET on $dev: $(ip -o address show dev "$dev" 2>/dev/null | awk '{print $4}' | tr '\n' ' ')"
}

mkdir -p /run/initramfs

# Secure Boot's state, the slots' records (KIRAslotN) and the sealed machine-id
# are EFI variables, read through efivarfs, which initramfs-tools does not mount
# (systemd does, as an API file system, on Arch). Without it run says the state
# cannot be read, and no slot is read: the boot goes on to the passphrase prompt.
if [ -d /sys/firmware/efi/efivars ] && ! grep -qs ' /sys/firmware/efi/efivars efivarfs ' /proc/mounts; then
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>>/run/initramfs/kira.log ||
        echo "kira: efivarfs is not mounted: neither Secure Boot's state nor a slot's record can be read" >>/run/initramfs/kira.log
fi
# The firmware's event log: what a phone and the vault replay against the quoted PCR 7
# to establish Secure Boot's state, and what says where the initrd was measured. It is
# in securityfs, which initramfs-tools does not mount either; init moves it with /sys.
if [ -d /sys/kernel/security ] && ! grep -qs ' /sys/kernel/security securityfs ' /proc/mounts; then
    mount -t securityfs securityfs /sys/kernel/security 2>>/run/initramfs/kira.log ||
        echo "kira: securityfs is not mounted: no event log, so a phone and the vault cannot establish Secure Boot's state" >>/run/initramfs/kira.log
fi

# The installed system's machine-id, sealed under slot 0's policy, released
# before the network as under systemd (kira-machine-id.service): written
# where the image's /etc/machine-id is. Whatever fails is said, the boot
# goes on.
case "$KIRA_NET" in
dhcp | static)
    KIRA_LOG=/run/initramfs/kira.log /usr/bin/kira-boot machine-id 2>>/run/initramfs/kira.log
    ;;
esac

# The code screen, the gate's coordinator and the key provider in one
# process; it stays for the keyscript until init-bottom stops it. A
# background job of a non-interactive shell would get /dev/null as stdin;
# Enter at the code screen is read from the console. What it reports
# (stderr: the key requests, the phone) goes to a log that survives into
# the booted system, /run/initramfs/kira.log - the journal's part
# under systemd.
mkdir -p /run/initramfs
# KIRA_REMOTE (--ssh ...) makes it the SSH server too, as the image's
# /etc/kira/assh.conf says. --ready-file is READY without systemd: what
# local-top's close waits for.
# shellcheck disable=SC2086
KIRA_LOG=/run/initramfs/kira.log /usr/bin/kira-boot run --plan "$PLAN" --unlock "$UNLOCK" --ready-file /run/kira/screen-over $KIRA_REMOTE </dev/console >/dev/console 2>>/run/initramfs/kira.log &
echo $! > /run/kira.pid

case "$KIRA_NET" in
dhcp | static)
    kira_net >>/run/initramfs/kira.log 2>&1 </dev/null &
    echo $! > /run/kira-net.pid
    ;;
esac
